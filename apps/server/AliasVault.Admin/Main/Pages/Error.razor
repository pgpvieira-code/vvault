@page "/Error"
@using System.Diagnostics

<LayoutPageTitle>Erro</LayoutPageTitle>

<h1 class="text-danger dark:text-red-400">Erro.</h1>
<h2 class="text-danger dark:text-red-400">Ocorreu um erro ao processar sua requisição.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>ID da requisição:</strong> <code class="dark:bg-gray-700 dark:text-gray-200">@RequestId</code>
    </p>
}

<h3 class="dark:text-white">Modo de desenvolvimento</h3>
<p class="dark:text-gray-300">
    Swapping to <strong>Desenvolvimento</strong> environment will display more detailed information about the error that occurred.
</p>
<p class="dark:text-gray-300">
    <strong>O ambiente de desenvolvimento não deve ficar ativo em aplicações publicadas.</strong>
    It can result in displaying sensitive information from exceptions to end users.
    For local debugging, enable the <strong>Desenvolvimento</strong> environment by setting the <strong>ASPNETCORE_ENVIRONMENT</strong> environment variable to <strong>Desenvolvimento</strong>
    and restarting the app.
</p>

@code{
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    /// <inheritdoc />
    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

}
